# Configuración de Ejemplo
# Copiar este archivo a .env y completar con valores reales

# ═══════════════════════════════════════════════════════════════════════════════
# WHATSAPP BUSINESS API (META)
# ═══════════════════════════════════════════════════════════════════════════════
# Obtener desde: https://developers.facebook.com -> Tu App -> WhatsApp -> API Setup

# Token de acceso permanente (System User Token recomendado para producción)
ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID del número de teléfono de WhatsApp Business
PHONE_NUMBER_ID=123456789012345

# Versión de la API de Graph (actualizar según la más reciente estable)
VERSION=v22.0

# Token secreto para verificar el webhook (definir uno único y seguro)
WEBHOOK_VERIFY_TOKEN=mi_token_secreto_super_seguro_123

# ═══════════════════════════════════════════════════════════════════════════════
# TURSO DATABASE (CLOUD SQLITE)
# ═══════════════════════════════════════════════════════════════════════════════
# Obtener desde: https://turso.tech -> Dashboard -> Tu Database

# URL de la base de datos (formato: libsql://nombre-db.turso.io)
TURSO_DATABASE_URL=libsql://whatsapp-tracking-tu-usuario.turso.io

# Token de autenticación (generar con: turso db tokens create <db-name>)
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE LA APLICACIÓN
# ═══════════════════════════════════════════════════════════════════════════════

# Puerto del servidor (Render lo asigna automáticamente)
PORT=5000

# Ambiente: development | production
FLASK_ENV=production

# Delay entre mensajes en envío masivo (segundos)
# Recomendado: 1.0-2.0 para evitar rate limits
DELAY_SECONDS=1.5

# Directorio de datos (para SQLite local si no se usa Turso)
DATA_DIR=.

# ═══════════════════════════════════════════════════════════════════════════════
# GOOGLE AI (GEMINI)
# ═══════════════════════════════════════════════════════════════════════════════
# Obtener desde: https://aistudio.google.com/apikey

GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
